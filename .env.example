# Neon PostgreSQL connection strings
# DATABASE_URL uses Neon's built-in PgBouncer pooler (?sslmode=require&pgbouncer=true)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL is the direct unpooled connection used for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Auth Secrets (64-char random hex or strong secret)
ACCESS_TOKEN_SECRET="replace-with-64-char-hex-access-secret"
REFRESH_TOKEN_SECRET="replace-with-64-char-hex-refresh-secret"

# Redis (Upstash) - used strictly for rate-limiting
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"

# App & CORS
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
COOKIE_DOMAIN=""

# Cloudflare R2 Storage (Phase 4)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="durg-uploads"
R2_PUBLIC_URL=""

# Resend Email (Phase 2 & Phase 6)
RESEND_API_KEY=""

# Backup Key (Production)
BACKUP_ENCRYPTION_KEY=""

